# Copy this file to .env and set your own Gemini API key.
# Never commit .env or a real API key.
GEMINI_API_KEY=replace_with_your_own_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Retrieval strategies: baseline | multi_query | rerank
# The default stays baseline for compatibility and rollback.
RAG_RETRIEVAL_MODE=baseline

# Reranking settings (used only when RAG_RETRIEVAL_MODE=rerank).
RAG_RERANK_CANDIDATES=80
RAG_RERANK_LEXICAL_WEIGHT=0.65

# Optional: include the next chunk from the same document section in rerank mode.
# Disabled by default; enable for the evaluated portfolio demo.
RAG_CONTEXT_NEIGHBORS=false

# Leave empty to disable similarity filtering. If set, use a number from 0 to 1.
RAG_MIN_SIMILARITY=
LOG_LEVEL=INFO
